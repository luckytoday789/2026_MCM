  "jsons": {
    "run_manifest.json": {
      "required_fields": [
        "schema_version",
        "plan_id",
        "source_commit",
        "canonical_git_sources",
        "consumed_source_sha256",
        "effective_config",
        "profile_horizons",
        "comparison_horizon",
        "horizons",
        "split",
        "input",
        "command",
        "python_version",
        "packages",
        "utc_start",
        "utc_end",
        "elapsed_seconds",
        "cpu_seconds",
        "status",
        "output_sha256",
        "output_counts"
      ],
      "source_hash_record": [
        "sha256",
        "git_blob_sha1",
        "crlf_checkout_sha256"
      ],
      "input_record": [
        "origin",
        "sha256",
        "fixture",
        "fixture_generator_sha256"
      ],
      "output_hash_map": "five non-manifest filenames -> SHA256 of actual LF output bytes",
      "failure_addition": "diagnosis={exception,message}; never fabricate missing outputs"
    },
    "checks.json": {
      "required_fields": [
        "status",
        "thresholds",
        "checks",
        "count",
        "failures",
        "split",
        "plan_id",
        "output_counts"
      ],
      "group_fields": [
        "status",
        "count",
        "failures",
        "max_absolute_residual",
        "max_scaled_residual"
      ],
      "residual_scaling": "abs(actual-expected)/max(abs(actual),abs(expected)); zero if both zero"
    }
  }
